generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Order {
  number            Int     @id @default(autoincrement())
  items            String
  total            Float
  payment          String
  status           String  @default("new")
  etaMinutes       Int
  createdAt        BigInt
  updatedAt        BigInt
  readyAt          BigInt
  clientTelegramId String?
  clientName       String?
  clientUsername   String?
  clientPhone      String?
}

model Barista {
  id        BigInt @id
  name      String @default("")
  role      String @default("barista")
  createdAt BigInt
}

model MenuCategory {
  id        String   @id
  name      String
  emoji     String   @default("📦")
  sort      Int      @default(0)
  createdAt BigInt
  updatedAt BigInt
}

model MenuProduct {
  id         String  @id
  categoryId String
  name       String
  price      Float
  desc       String  @default("")
  emoji      String  @default("☕")
  image      String?
  active     Boolean @default(true)
  sort       Int     @default(0)
  volume     String  @default("")
  createdAt  BigInt
  updatedAt  BigInt
}
