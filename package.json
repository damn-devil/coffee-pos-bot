{
  "name": "coffee-pos-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram-бот + Mini App для кофейни: меню, заказы, уведомления баристе, таймеры",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "sh -c \"npx prisma migrate deploy && node dist/index.js\"",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "express": "^4.21.2",
    "grammy": "^1.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
