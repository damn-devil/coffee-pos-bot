# Telegram-бот и Mini App для кофейни
# Копия этого файла в .env и заполни значения

# --- Обязательные ---
BOT_TOKEN=123456:ABC-your-bot-token
DATABASE_URL="file:./dev.db"

# --- Баристы (Telegram chat_id, через запятую; например: -1001234567890 или 987654321) ---
BARISTA_CHAT_IDS=0

# --- Mini App URLs (после деплоя) ---
MINI_APP_MENU_URL=https://pos.example.com/menu
MINI_APP_ORDERS_URL=https://pos.example.com/orders

# --- Webhook (production) ---
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- Бар API key для /api/orders (опционально, для production hardening) ---
BARISTA_API_KEY=

# --- Порт сервера ---
PORT=3000

# --- URL меню (меню кофейни, обновляется из меню кофейни) ---
MENU_URL=https://raw.githubusercontent.com/damn-devil/coffee-pos/main/menu.json
